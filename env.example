# ---- Existing Philia AI ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- Production event / bespoke / corporate request database ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Shopify secure App Proxy + native Admin sync ----
# Example: philia-flowers-kw.myshopify.com
SHOPIFY_STORE_DOMAIN=
# App client secret used to validate signed App Proxy requests
SHOPIFY_API_SECRET=
# Admin API access token. Required scopes: read_customers, write_draft_orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-10

# ---- Merchant dashboard ----
ADMIN_DASHBOARD_USER=philia
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Email notifications ----
PHILIA_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Optional Render Cron daily summary ----
CRON_SECRET=

# Development only. Keep false in production.
ALLOW_UNSIGNED_PROXY=false
