# Existing Philia AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shopify-native Philia Request System — no PostgreSQL / DATABASE_URL
# SHOPIFY_SHOP is only the subdomain, e.g. philia-flowers-kw
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=2026-10

# Optional email notifications for new/edit/cancel events.
# The request system works without these; data is always saved in Shopify.
PHILIA_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Development only. Keep false in production.
ALLOW_UNSIGNED_PROXY=false

# Optional signed app-proxy store aliases (only domains confirmed as belonging to your Shopify store)
SHOPIFY_PROXY_ALLOWED_SHOPS=
